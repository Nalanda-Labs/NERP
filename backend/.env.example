# Copy to .env and adjust. All values can also be set as real environment variables.
BIND_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://nerp:change-me@127.0.0.1:5432/nerp
DATABASE_MAX_CONNECTIONS=20
REDIS_URL=redis://127.0.0.1:6379
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=2592000
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=52428800
# Serve the built frontend from the same process (leave empty in development)
STATIC_DIR=
# Only needed if the frontend is served from a different origin
CORS_ORIGINS=
# Set to false only for plain-HTTP local development
COOKIE_SECURE=true
# Trust X-Forwarded-For (only behind a reverse proxy you control)
TRUST_PROXY=false
# Address people use to open NERP (used for links in emails)
PUBLIC_URL=http://localhost:5173
# Outgoing email
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# none | starttls | tls
SMTP_SECURITY=none
# Accept self-signed certificates (local development only, e.g. Mailpit)
SMTP_ACCEPT_INVALID_CERTS=false
MAIL_FROM="NERP <no-reply@nerp.local>"
# Background job worker (run it in at least one instance)
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
# Document engines (Typst is built in; these are optional)
LUALATEX_BIN=lualatex
SOFFICE_BIN=soffice
DOC_RENDER_TIMEOUT_SECS=60
DOC_RENDER_CONCURRENCY=2
# Let automation webhooks call private-network addresses (loopback, LAN)
CRM_WEBHOOK_ALLOW_PRIVATE=false
RUST_LOG=info,sqlx=warn,tower_http=info
# Secrets stored in the database (mailbox passwords, OAuth tokens). Defaults to a key
# derived from JWT_SECRET; set your own (32+ characters) to rotate JWT_SECRET independently.
DATA_ENCRYPTION_KEY=
# "Connect Gmail" / "Connect Microsoft 365". Redirect URI to register with both providers:
#   {PUBLIC_URL}/api/crm/mailboxes/oauth/callback
#   dev (npm run dev):        http://localhost:5173/api/crm/mailboxes/oauth/callback
#   dev (backend serves app): http://localhost:8080/api/crm/mailboxes/oauth/callback
#   production:               https://crm.example.com/api/crm/mailboxes/oauth/callback
# It must match exactly (no trailing slash); http:// only works for localhost.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Video calls across networks: a TURN server (RTCIceServer list as JSON). Empty: same network only.
WEBRTC_ICE_SERVERS=[]

# LDAP directory sign-in and sync (Administration → Directory & sign-on). false: not offered at all.
LDAP_ENABLED=false

# Calls through a LiveKit media server (and recording them). Empty LIVEKIT_URL: browsers connect
# to each other directly, as before. LIVEKIT_URL is what browsers reach (ws:// or wss://);
# LIVEKIT_API_URL (optional) is what NERP calls, e.g. http://127.0.0.1:7880.
LIVEKIT_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Recording: the folder LiveKit Egress writes recordings to, as NERP sees it. Empty: no
# recording. LIVEKIT_EGRESS_DIR is the same folder as Egress sees it, if different (container).
LIVEKIT_RECORDINGS_DIR=
LIVEKIT_EGRESS_DIR=
