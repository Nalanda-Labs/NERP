		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@excalidraw/excalidraw": "^0.18.1",
		"@lezer/highlight": "^1.2.5",
		"@mediapipe/tasks-vision": "^1.2.2",
		"@tiptap/core": "^3.33.1",
		"@tiptap/extension-collaboration": "^3.33.1",
