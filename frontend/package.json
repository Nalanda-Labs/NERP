{
	"name": "frontend",
	"version": "1.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"predev": "node scripts/excalidraw-assets.mjs && node scripts/mediapipe-assets.mjs",
		"prebuild": "node scripts/excalidraw-assets.mjs && node scripts/mediapipe-assets.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
